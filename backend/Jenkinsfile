pipeline {
    agent any

    tools {
        maven 'Maven 3.9'
        jdk 'Java 17'
    }

    environment {
        MAVEN_HOME = '/usr/share/maven'
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk'
        PROJECT_NAME = "PetPal-Backend"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(false)
    }

    stages {
        stage('Checkout') {
            steps {
                echo "✅ Checkout code..."
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "🔨 Building with Maven..."
                sh '''
                    cd backend
                    mvn clean compile
                '''
            }
        }

        stage('Test') {
            steps {
                echo "🧪 Running tests..."
                sh '''
                    cd backend
                    mvn test -DskipTests
                '''
            }
        }

        stage('Code Quality') {
            when {
                branch 'develop'
            }
            steps {
                echo "📊 Code quality analysis..."
                sh '''
                    cd backend
                    mvn sonar:sonar \
                      -Dsonar.projectKey=petpal-backend \
                      -Dsonar.sources=src/main/java \
                      -Dsonar.tests=src/test/java \
                      || echo "SonarQube not configured"
                '''
            }
        }

        stage('Package') {
            steps {
                echo "📦 Packaging JAR..."
                sh '''
                    cd backend
                    mvn package -DskipTests
                    ls -lh target/*.jar
                '''
            }
        }
    }

    post {
        always {
            deleteDir()
        }
        success {
            echo "✅ Build successful!"
        }
        failure {
            echo "❌ Build failed!"
        }
    }
}
